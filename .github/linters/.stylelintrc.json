{
  "extends": "stylelint-config-standard",
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "layer",
          "tailwind",
          "apply",
          "variant",
          "custom-variant",
          "utility",
          "plugin",
          "config",
          "source",
          "reference"
        ]
      }
    ],
    "import-notation": "string",
    "value-keyword-case": ["lower", { "ignoreProperties": ["/^--font/"] }],
    "custom-property-empty-line-before": null,
    "rule-empty-line-before": null
  }
}
