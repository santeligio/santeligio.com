---
import { NAV, SITE } from '../consts';
import { localeFromUrl, localePath, useTranslations } from '../i18n';

const lang = localeFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-parchment-200 bg-ink-900 text-parchment-100">
  <div
    class="mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-3"
  >
    <div>
      <h2 class="font-serif text-lg text-parchment-50">{SITE.title}</h2>
      <p class="mt-2 max-w-xs text-sm text-parchment-200">
        {t.ui.footerTagline}
      </p>
    </div>

    <nav aria-label={t.ui.footerNav}>
      <h2 class="font-serif text-sm uppercase tracking-wide text-gold-500">
        {t.ui.footerPages}
      </h2>
      <ul class="mt-2 space-y-1 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a class="hover:text-gold-500" href={localePath(item.href, lang)}>
                {t.nav[item.key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="font-serif text-sm uppercase tracking-wide text-gold-500">
        {t.ui.footerContacts}
      </h2>
      <p class="mt-2 text-sm">
        <a class="hover:text-gold-500" href={`mailto:${SITE.email}`}>
          {SITE.email}
        </a>
      </p>
    </div>
  </div>

  <div class="border-t border-ink-800">
    <p
      class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-4 px-4 py-4 text-xs text-parchment-200"
    >
      <span>© 2023–{year} Compagnia di Sant'Eligio. {t.ui.rightsReserved}</span>
      <a class="hover:text-gold-500" href={localePath('/privacy', lang)}>
        {t.ui.privacy}
      </a>
    </p>
  </div>
</footer>
